# ---------------------------------------------------------------------------
# warden-icarus: copy to .env, then fill in (cp .env.example .env)
# This example file contains NO secret.
# ---------------------------------------------------------------------------

# --- Discord ---------------------------------------------------------------
# Bot token (Discord Developer Portal > Bot > Reset Token). SECRET.
DISCORD_TOKEN=
# Discord server ID (right-click the server > Copy Server ID).
GUILD_ID=
# ID of the role allowed to act (start, stop, back up, restore, settings).
ADMIN_ROLE_ID=

# Existing channels
CHANNEL_PANEL_ID=1454421597862494282
CHANNEL_BACKUPS_ID=1458567565231132954
CHANNEL_SETTINGS_ID=1532111143949172837
CHANNEL_LOGS_ID=1533302977320718467

# --- User / Docker ---------------------------------------------------------
PUID=1000
PGID=1000
# GID of the host's docker group: getent group docker | cut -d: -f3
DOCKER_GID=

# --- Icarus ----------------------------------------------------------------
ICARUS_CONTAINER=icarus
# Folder containing the Icarus docker-compose.yml, .env, data/, game/ (mornedhels/icarus-server image).
# The bot also edits data/Saved/Config/WindowsServer/ServerSettings.ini there.
ICARUS_DIR=/home/lucky/icarus
# Backup archives (default: $ICARUS_DIR/backups).
BACKUP_DIR=/home/lucky/icarus/backups
# Number of archives kept.
BACKUP_RETENTION=14
# A2S queries (Icarus query port).
A2S_HOST=127.0.0.1
A2S_PORT=32784
# Clean stop timeout in seconds (minimum 60, to let the game save).
# 90 = supervisord's stopwaitsecs in the image.
STOP_TIMEOUT=90
# Maximum duration of a container recreation (docker compose up), in seconds.
RECREATE_TIMEOUT=600

# --- Behaviour -------------------------------------------------------------
TZ=Europe/Paris
# Server panel refresh (s) and player polling (s).
PANEL_REFRESH_SECONDS=60
PLAYER_POLL_SECONDS=20
# A departure is announced only if the player is still missing after N s: joining briefly
# disconnects the player (lobby -> prospect), which would otherwise show join / leave / join.
PLAYER_LEAVE_GRACE_SECONDS=120
# Scheduled restart time, disabled by default: the image already updates the game itself
# (UPDATE_CRON, empty server). Can be enabled and changed from the settings channel.
SCHEDULED_RESTART_TIME=06:00
# Restart anyway if A2S does not answer (players unknown)? false = postpone.
SCHEDULED_RESTART_IF_A2S_DOWN=false
# Exit codes considered a normal stop (not a crash), comma-separated.
CLEAN_EXIT_CODES=0
# Arrival/departure detection: a2s, logs or both.
PLAYER_DETECTION=a2s

# --- Container logs --------------------------------------------------------
# JSON patterns file (see patterns.example.json), path AS SEEN FROM the bot container,
# e.g. /app/state/patterns.json. Empty = default patterns.
LOG_PATTERNS_FILE=
# Only these lines are published: start-up, real update, crash, arrivals/departures.
# true = also publish generic errors ("❌", very chatty with Unreal under Wine).
ERROR_LOGS_TO_DISCORD=false
# Anti-spam: the same line at most every N s, and at most M lines per minute.
LOG_DEDUPE_SECONDS=300
LOG_MAX_PER_MINUTE=10
# true = at most one discreet message per hour saying how many lines the anti-spam dropped.
LOG_SPAM_SUMMARY=false
LOG_LEVEL=INFO

# --- ntfy (optional) -------------------------------------------------------
# Leave NTFY_URL empty to disable. E.g.: https://ntfy.sh or https://ntfy.mydomain.com
NTFY_URL=
# Access token (tk_...) if the topic is protected. SECRET.
NTFY_TOKEN=
NTFY_TOPIC=icarus
