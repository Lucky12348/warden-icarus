# ---------------------------------------------------------------------------
# warden-icarus — copier en .env puis compléter (cp .env.example .env)
# Ce fichier d'exemple ne contient AUCUN secret.
# ---------------------------------------------------------------------------

# --- Discord ---------------------------------------------------------------
# Token du bot (Discord Developer Portal > Bot > Reset Token). SECRET.
DISCORD_TOKEN=
# ID du serveur Discord (clic droit sur le serveur > Copier l'identifiant).
GUILD_ID=
# ID du rôle autorisé à agir (démarrer, arrêter, sauvegarder, restaurer, réglages).
ADMIN_ROLE_ID=

# Salons existants
CHANNEL_PANEL_ID=1454421597862494282
CHANNEL_BACKUPS_ID=1458567565231132954
CHANNEL_SETTINGS_ID=1532111143949172837
CHANNEL_LOGS_ID=1533302977320718467

# --- Utilisateur / Docker --------------------------------------------------
PUID=1000
PGID=1000
# GID du groupe docker de l'hôte : getent group docker | cut -d: -f3
DOCKER_GID=

# --- Icarus ----------------------------------------------------------------
ICARUS_CONTAINER=icarus
# Dossier contenant docker-compose.yml, .env, data/, game/ d'Icarus.
ICARUS_DIR=/home/lucky/icarus
# Archives de sauvegarde (par défaut : $ICARUS_DIR/backups).
BACKUP_DIR=/home/lucky/icarus/backups
# Nombre d'archives conservées.
BACKUP_RETENTION=14
# Requêtes A2S (port query d'Icarus).
A2S_HOST=127.0.0.1
A2S_PORT=32784
# Délai d'arrêt propre en secondes (minimum 60, pour laisser le jeu sauvegarder).
STOP_TIMEOUT=60
# Délai maximal d'une recréation du conteneur (docker compose up), en secondes.
RECREATE_TIMEOUT=600

# --- Comportement ----------------------------------------------------------
TZ=Europe/Paris
# Rafraîchissement du panneau serveur (s) et interrogation des joueurs (s).
PANEL_REFRESH_SECONDS=60
PLAYER_POLL_SECONDS=20
# Heure initiale du redémarrage planifié (modifiable ensuite depuis Discord).
SCHEDULED_RESTART_TIME=06:00
# Redémarrer quand même si A2S ne répond pas (joueurs inconnus) ? false = reporter.
SCHEDULED_RESTART_IF_A2S_DOWN=false
# Codes de sortie considérés comme un arrêt normal (pas un crash), séparés par des virgules.
CLEAN_EXIT_CODES=0
# Détection des arrivées/départs : a2s, logs ou both.
PLAYER_DETECTION=a2s

# --- Logs du conteneur -----------------------------------------------------
# Fichier JSON de motifs (voir patterns.example.json), chemin VU DEPUIS le conteneur du bot,
# par ex. /app/state/patterns.json. Vide = motifs par défaut.
LOG_PATTERNS_FILE=
# Anti-spam : une même ligne au plus toutes les N s, et au plus M lignes par minute.
LOG_DEDUPE_SECONDS=300
LOG_MAX_PER_MINUTE=10
LOG_LEVEL=INFO

# --- ntfy (optionnel) ------------------------------------------------------
# Laisser NTFY_URL vide pour désactiver. Ex. : https://ntfy.sh ou https://ntfy.mondomaine.fr
NTFY_URL=
# Jeton d'accès (tk_...) si le topic est protégé. SECRET.
NTFY_TOKEN=
NTFY_TOPIC=icarus
