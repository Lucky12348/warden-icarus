
# --- Non-secret settings (managed by warden-icarus) ---
# Translated by docker-compose.yml to the mornedhels/icarus-server variables (SERVER_NAME...).
SERVERNAME=ZEHEFLAND
MAX_PLAYERS=8
SHUTDOWN_NOT_JOINED_FOR=300
SHUTDOWN_EMPTY_FOR=300
ALLOW_NON_ADMINS_LAUNCH=True
ALLOW_NON_ADMINS_DELETE=False
RESUME_PROSPECT=False
